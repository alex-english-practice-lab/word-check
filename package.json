{
  "name": "word-check",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser.cjs",
    "test:learn-browser": "node tests/learn-browser.cjs",
    "test:learning-assignment-browser": "node tests/learning-assignment-browser.cjs",
    "test:progress-browser": "node tests/progress-browser.cjs",
    "test:student-identity-browser": "node tests/student-identity-browser.cjs",
    "test:assigned-cloud-browser": "node tests/assigned-cloud-browser.cjs",
    "test:browser:all": "npm run test:browser && npm run test:learn-browser && npm run test:learning-assignment-browser && npm run test:progress-browser && npm run test:student-identity-browser && npm run test:assigned-cloud-browser",
    "test:all": "npm test && npm run test:browser:all",
    "setup:browser": "playwright install chromium"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "1.51.1"
  }
}
