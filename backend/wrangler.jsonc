{
  "name": "word-check-classroom-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "FRONTEND_ORIGIN": "https://alex-english-practice-lab.github.io"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "word-check-classroom",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [{
    "name": "SELECT_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 30, "period": 60 }
  }]
}
