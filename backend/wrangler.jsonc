{
  "name": "word-check-classroom-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "FRONTEND_ORIGIN": "https://alex-english-practice-lab.github.io"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "word-check-classroom",
    "database_id": "cecf28ba-6e8b-429a-b4ba-922592fe1b13",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [{
    "name": "SELECT_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 30, "period": 60 }
  }]
}
